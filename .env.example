# ---------- AI ----------
# Fireworks AI — endpoint compatible con Anthropic Messages API (ver docs/MODEL_COST_MIGRATION.md)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.fireworks.ai/inference
ANTHROPIC_MODEL_ORCHESTRATOR=accounts/fireworks/models/minimax-m3
ANTHROPIC_MODEL_DIALOG=accounts/fireworks/models/deepseek-v4-flash-0731

# ---------- Voice ----------
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs account. Voice Library / professional voices
# work in the web UI but require a paid ElevenLabs plan for API access (402).
# Use an Instant Voice Clone you own, or set TTS_PROVIDER=azure.
ELEVENLABS_VOICE_ID=
# Primary voice knob — changing this is enough; TTS_VOICE is optional legacy alias.
# If both are set, ELEVENLABS_VOICE_ID wins.
ELEVENLABS_MODEL=eleven_flash_v2_5
# mp3_44100_128 plays reliably on iOS; pcm_16000 needs WAV wrap on device
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TRANSPORT=rest
# Or switch to Azure Neural TTS: TTS_PROVIDER=azure + AZURE_TTS_KEY
TTS_PROVIDER=elevenlabs
STT_LANGUAGE=es-MX
# Use your 20-char voice ID: TTS_VOICE=elevenlabs:YOUR_VOICE_ID_HERE
TTS_VOICE=elevenlabs:YOUR_VOICE_ID_HERE
# Proactive greeting when the chat opens (1=on). Spoken via ElevenLabs TTS.
VOICE_WELCOME=1
# Optional override; default is es-MX copy in voice-gateway/pipeline/session.py
VOICE_WELCOME_MESSAGE=
CO_VOICE_REQUIRE_AUTH=0

# ---------- Orchestrator guardrails ----------
# Blocks obvious prompt-injection / jailbreak patterns before LLM calls (1=on).
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_MAX_CHARS=4000

# ---------- Identity ----------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=

# ---------- Tenant ----------
TENANT_ID=stage-cdmx-morelos

# ---------- Whole-market ingest (Inmuebles24 + EasyBroker) ----------
# Apify token — https://console.apify.com
APIFY_API_TOKEN=
# Photo-capable actor (naventcdn URLs). Alternatives:
#   ecomscrape/inmuebles24-property-listings-scraper
#   juandiaz.mx/inmuebles24-scraper  (legacy — page URLs only, no photos)
APIFY_INMUEBLES24_ACTOR=azzouzana/inmuebles24-scraper-pro-by-search-url
# Store actor (default). After `make deploy-vivanuncios-actor`, switch to live:
#   INGEST_VIVANUNCIOS_LIVE=1
#   APIFY_VIVANUNCIOS_ACTOR=YOUR_USERNAME/vivanuncios-mx-scraper
APIFY_VIVANUNCIOS_ACTOR=stealth_mode/vivanuncios-property-search-scraper
INGEST_VIVANUNCIOS_LIVE=0
APIFY_PROPIEDADES_ACTOR=fatihtahta/propiedades-scraper
APIFY_LAMUDI_INVENTORY_ACTOR=thescrapelab/the-ultimate-property-scraper
# Live lamudi.com.mx list scrape (deploy infra/apify/lamudi-mx-scraper then apify push)
INGEST_LAMUDI_LIVE=0
APIFY_LAMUDI_ACTOR=YOUR_USERNAME/lamudi-mx-scraper
APIFY_MERCADOLIBRE_ACTOR=YOUR_USERNAME/mercadolibre-inmuebles-mx-scraper
# Custom live actor (deploy infra/apify/mercadolibre-inmuebles-mx-scraper). Legacy paid rental:
# APIFY_MERCADOLIBRE_LEGACY_ACTOR=ecomscrape/mercadolibre-product-search-scraper
INGEST_MERCADOLIBRE_LIVE=0
APIFY_MERCADOLIBRE_MAX_PAGES=10
APIFY_MERCADOLIBRE_TIMEOUT_SEC=300
APIFY_MERCADOLIBRE_MAX_ITEMS=80
# Full-grid multi-URL batching (option B): N search URLs per Apify run.
# Prefer per-portal overrides. Global APIFY_URL_BATCH_SIZE applies to any portal
# that does not set its own size (avoid for Propiedades / juandiaz I24).
# APIFY_URL_BATCH_SIZE=15
APIFY_VIVANUNCIOS_BATCH_SIZE=15
APIFY_LAMUDI_BATCH_SIZE=15
APIFY_MERCADOLIBRE_BATCH_SIZE=15
# Per-portal raw caps (each ≤ MARKET_MAX_ITEMS_PER_QUERY).
APIFY_INMUEBLES24_MAX_ITEMS=80
APIFY_VIVANUNCIOS_MAX_ITEMS=80
APIFY_VIVANUNCIOS_MAX_PAGES=10
APIFY_PROPIEDADES_MAX_ITEMS=80
APIFY_LAMUDI_MAX_ITEMS=80
APIFY_LAMUDI_MAX_PAGES=10
# Residential MX proxies help portal scrapers succeed (Apify billing applies)
APIFY_USE_RESIDENTIAL_PROXY=1
# Apify sync-run timeout per query/batch (seconds). Sync API hard-caps at 300s; >300 uses async poll.
APIFY_RUN_TIMEOUT_SEC=300
APIFY_VIVANUNCIOS_TIMEOUT_SEC=480
APIFY_QUERY_RETRIES=2
# Comma-separated portal adapters: inmuebles24,vivanuncios,propiedades,lamudi,mercadolibre
INGEST_PORTALS=inmuebles24,vivanuncios,propiedades,lamudi,mercadolibre
INGEST_INMUEBLES24=1
INGEST_VIVANUNCIOS=1
INGEST_PROPIEDADES=1
INGEST_LAMUDI=1
INGEST_MERCADOLIBRE=1
MARKET_MAX_ITEMS_PER_QUERY=80
MARKET_QUERIES_PATH=data/market_queries.json
MARKET_COLONIAS_QUERIES_PATH=data/market_queries_colonias.json
MARKET_MANIFEST_PATH=data/cache/market_manifest.json

# ---------- EasyBroker (optional — your CRM + MLS network) ----------
# API key: EasyBroker → Configuración → API para programadores (administrator required)
EASYBROKER_API_KEY=
# Set to 1 to ingest only published listings; default 0 = all then filter available
EASYBROKER_PUBLISHED_ONLY=0
# MLS collaborator inventory across the network (requires EasyBroker API MLS plan)
EASYBROKER_INCLUDE_MLS=1
# After `make ingest-public`, people index is read from data/cache/people_index.json
PEOPLE_INDEX_PATH=data/cache/people_index.json
LISTINGS_URL=http://localhost:8002
# Near-match rent/sale search: max price = budget × factor when no exact hits (default 1.5)
MATCHING_NEAR_PRICE_FACTOR=1.5
MATCHING_NEAR_MIN_RESULTS=5

# ---------- Public registries (audit_agent) ----------
# mock | live | auto (try live, fall back to mock — default)
REGISTRY_MODE=auto
# Free token: https://www.inegi.org.mx/app/api/denue.html
INEGI_API_TOKEN=
# Optional broker/RPA endpoint for state RPP title search (POST JSON address)
RPP_LOOKUP_URL=
SAT_CACHE_DIR=data/cache/sat
SAT_CACHE_TTL_HOURS=24
CDMX_CATASTRO_WFS_URL=https://catalogov2.sig.cdmx.gob.mx/geoserver/wfs
REGISTRY_HTTP_TIMEOUT_S=12

# ---------- Phase 6 — maps, tours, routing (post-pilot) ----------
# haversine (free) | mapbox | google | osrm
ROUTING_PROVIDER=haversine
ROUTING_URL=http://localhost:8008
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
GEOCODE_URL=https://nominatim.openstreetmap.org/search
GEOCODE_DELAY_S=1.1
TOUR_MAX_STOPS=6
TOUR_DWELL_MINUTES=45
TOUR_TRAVEL_BUFFER_MINUTES=10
# Google Calendar OAuth (Tier B — optional until P6.5)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Mobile: set EXPO_PUBLIC_PHASE6_MAPS=1 when MapScreen ships (P6.1)
EXPO_PUBLIC_PHASE6_MAPS=0
EXPO_PUBLIC_ROUTING_URL=http://localhost:8008

# ---------- Comms ----------
WHATSAPP_SIMULATED=false
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=

# ---------- Compliance ----------
CFDI_PAC_SIMULATED=true
MIFIEL_SIMULATED=true
LFPDPPP_AVISO_VERSION=1.0

# ---------- Storage / Observability ----------
POSTGRES_URL=postgres://casa:casa@postgres:5432/casa
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=
S3_BUCKET=casa-audit
S3_ACCESS_KEY=
S3_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
SENTRY_DSN=
