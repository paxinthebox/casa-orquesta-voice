{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_VOICE_GATEWAY_URL": "wss://voice-dev.casaorquesta.mx",
        "EXPO_PUBLIC_ORCHESTRATOR_URL": "https://api-dev.casaorquesta.mx"
      },
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENV": "preview",
        "EXPO_PUBLIC_VOICE_GATEWAY_URL": "wss://voice-stage.casaorquesta.mx",
        "EXPO_PUBLIC_ORCHESTRATOR_URL": "https://api-stage.casaorquesta.mx"
      },
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_VOICE_GATEWAY_URL": "wss://voice.casaorquesta.mx",
        "EXPO_PUBLIC_ORCHESTRATOR_URL": "https://api.casaorquesta.mx"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "ops@casaorquesta.mx",
        "ascAppId": "0000000000",
        "appleTeamId": "XXXXXXXXXX"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
