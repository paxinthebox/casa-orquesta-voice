# Auth0 (get from Auth0 dashboard → Applications → your app)
# Leave blank in local dev until you have real credentials — placeholders break the native SDK.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=

# Backend service URLs
EXPO_PUBLIC_ORCHESTRATOR_URL=
EXPO_PUBLIC_VOICE_GATEWAY_URL=
EXPO_PUBLIC_IDENTITY_URL=
EXPO_PUBLIC_LISTINGS_URL=http://localhost:8002
EXPO_PUBLIC_SCHEDULING_URL=http://localhost:8080/api/scheduling

# Must match voice-gateway ELEVENLABS_OUTPUT_FORMAT (mp3_44100_128 with REST transport).
EXPO_PUBLIC_TTS_AUDIO_FORMAT=mp3
# EXPO_PUBLIC_DEVICE_TTS_FALLBACK=1 — system voice if gateway audio cannot play (useful on simulator).

# Set to 0 to force the LFPDPPP consent screen in the simulator
# EXPO_PUBLIC_SKIP_CONSENT=0
