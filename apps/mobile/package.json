{
  "name": "casa-orquesta-voice-mobile",
  "version": "0.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "mobile:clear": "expo start -c",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --watchAll=false",
    "test:e2e": "detox test",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview:android": "eas build --profile preview --platform android"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@sentry/react-native": "^6.3.0",
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.0",
    "expo-file-system": "~18.0.0",
    "expo-haptics": "~14.0.0",
    "expo-localization": "~16.0.0",
    "expo-location": "~18.0.4",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-speech": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "i18next": "^23.16.0",
    "intl": "^1.2.5",
    "react": "18.3.1",
    "react-i18next": "^15.1.0",
    "react-native": "0.76.0",
    "react-native-auth0": "^4.5.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-maps": "1.18.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.8.0",
    "react-native-web": "^0.19.13",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "^20.27.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.6.0"
  }
}
